# PROPZY Environment Variables Example Template

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://letsrentz_admin:Infinologylexvra@cluster0.saq1nen.mongodb.net/letsrentz?retryWrites=true&w=majority&appName=Cluster0

# Admin Portal Credentials Configuration
ADMIN_ID=admin@propzy.com

ADMIN_PASSWORD=admin

# JWT Auth Secret (Specify JWT_SECRET or NEXTAUTH_SECRET)
JWT_SECRET=your_jwt_secret_key_here
NEXTAUTH_SECRET=your_jwt_secret_key_here

# Cloudinary Image Storage Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

